# 依存の lifecycle スクリプトを実行しない（サプライチェーン攻撃対策）
# 注: 自プロジェクトの prepare (husky) も止まるため、初回セットアップは `mise run setup`
ignore-scripts=true

# 公開から 7 日未満のバージョンをインストールしない（npm >= 11.10 必須、未満は黙って無視）
min-release-age=7

# install 時に脆弱性監査 / `npm audit` の失敗閾値は moderate
audit=true
audit-level=moderate

# package.json の engines を強制（古い npm が min-release-age を黙殺するのを防ぐ）
engine-strict=true
