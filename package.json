{
  "name": "rr7-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "check": "npm run format && npm run lint:fix && npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "cross-env STORYBOOK=true storybook dev -p 6006",
    "build-storybook": "cross-env STORYBOOK=true storybook build",
    "gen": "hygen component",
    "prepare": "husky"
  },
  "dependencies": {
    "@react-router/node": "^7.14.2",
    "@react-router/serve": "^7.14.2",
    "isbot": "^5.1.39",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router": "^7.14.2"
  },
  "devDependencies": {
    "@iconify-json/mingcute": "^1.2.7",
    "@react-router/dev": "^7.14.2",
    "@storybook/addon-a11y": "^9.1.20",
    "@storybook/addon-docs": "^9.1.20",
    "@storybook/react-vite": "^9.1.20",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "cross-env": "^10.1.0",
    "daisyui": "^5.5.19",
    "eslint-plugin-jsdoc": "^63.0.2",
    "husky": "^9.1.7",
    "hygen": "^6.2.11",
    "jsdom": "^25.0.1",
    "knip": "^6.16.1",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "storybook": "^9.1.20",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3",
    "unplugin-icons": "^23.0.1",
    "vite": "^6.4.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.10"
  }
